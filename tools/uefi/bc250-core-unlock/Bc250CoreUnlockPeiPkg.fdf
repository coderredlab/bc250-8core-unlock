[FV.Bc250CoreUnlockPei]
FvForceRebase      = FALSE
FvNameGuid         = DDDB579F-C0E4-48CF-9DDF-2236FC1E7C42
BlockSize          = 0x1000
NumBlocks          = 0
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

INF Bc250CoreUnlockPei/Bc250CoreUnlockPei.inf

[Rule.Common.PEIM]
  FILE PEIM = $(NAMED_GUID) {
    PEI_DEPEX PEI_DEPEX Optional $(INF_OUTPUT)/$(MODULE_NAME).depex
    TE TE $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI STRING="$(MODULE_NAME)"
    VERSION STRING="$(INF_VERSION)" Optional BUILD_NUM=$(BUILD_NUMBER)
  }
